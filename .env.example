# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=

# Model roles. Provider is "groq" or "ollama".
# The Groq model IDs below are PLACEHOLDERS until checked against the Groq console.
LAHJA_CURRENT_PROVIDER=groq
LAHJA_CURRENT_MODEL=llama-3.3-70b-versatile
LAHJA_CANDIDATE_PROVIDER=ollama
LAHJA_CANDIDATE_MODEL=llama3.2:3b
# The judge must be a NON-Llama family (self-preference bias, see README).
LAHJA_JUDGE_PROVIDER=groq
LAHJA_JUDGE_MODEL=openai/gpt-oss-120b

# LAHJA_DB_URL=sqlite:///lahja.db
# OLLAMA_BASE_URL=http://localhost:11434/v1
# LAHJA_TRIALS=3
# LAHJA_TEMPERATURE=0.7
# LAHJA_MARGIN=0.03
# LAHJA_SEED=0
