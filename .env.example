# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=

# Model roles. Provider is "groq" or "ollama".
# Three different families so the judge can't favour either side (self-preference bias):
# current = OpenAI, candidate = Meta Llama, judge = Alibaba Qwen.
LAHJA_CURRENT_PROVIDER=groq
LAHJA_CURRENT_MODEL=openai/gpt-oss-120b
LAHJA_CANDIDATE_PROVIDER=ollama
LAHJA_CANDIDATE_MODEL=llama3.2:3b
LAHJA_JUDGE_PROVIDER=groq
LAHJA_JUDGE_MODEL=qwen/qwen3.8-27b

# LAHJA_DB_URL=sqlite:///lahja.db
